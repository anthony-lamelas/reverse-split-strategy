# Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit .env files to git!

# MongoDB Connection String (REQUIRED)
MONGODB_URI=your_mongodb_connection_string_here
# Optional overrides (defaults: split_strategy / reverse_splits)
# MONGODB_DATABASE=split_strategy
# MONGODB_COLLECTION=reverse_splits

# OpenAI API Key (REQUIRED for the EDGAR scanner LLM classification)
OPENAI_API_KEY=your_openai_api_key_here

# SEC fair-access requires a REAL contact (name + email). Do not ship the placeholder.
SEC_USER_AGENT=Your Name your_real_email@example.com

# Polygon.io API Key (Optional - unused hook for a future price source)
POLYGON_API_KEY=your_polygon_api_key_here

# --- Schwab Trader API (automation; see docs/SCHWAB_SETUP.md) ---
SCHWAB_APP_KEY=your_schwab_app_key_here
SCHWAB_APP_SECRET=your_schwab_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# SCHWAB_ACCOUNT_HASH=optional_specific_account_hash
# SCHWAB_TOKEN_PATH=.schwab_token.json

# --- Trading / sizing (optional; defaults shown) ---
# ACCOUNT_SIZE=10000

# --- Optional email alerts for the daily signal run ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL_TO=you@gmail.com
