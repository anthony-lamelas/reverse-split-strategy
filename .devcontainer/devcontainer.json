{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  // The Streamlit dashboard was retired in favour of scripts/dashboard.py, a
  // print-once terminal tool. There is no longer a server to auto-start, no port to
  // forward and no web preview - so this container installs and gets out of the way.
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "docs/COMMANDS.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo '✅ Packages installed and Requirements met'"
}
